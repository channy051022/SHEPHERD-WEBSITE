# Supabase Configuration for BibleNote Landing Page
# Replace with your Supabase project credentials (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional direct APK download URL (if hosted externally or on custom CDN)
# If left empty, will fall back to Supabase Storage bucket 'app-releases/biblenote-release.apk'
VITE_APP_DOWNLOAD_URL=

# SMTP Email Configuration for App Update Notifications (Optional)
# Supports Gmail, Outlook, Brevo, SendGrid, Amazon SES, or custom SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="BibleNote (SHEPHERD)" <your-email@gmail.com>
